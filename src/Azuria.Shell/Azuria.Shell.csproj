<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Azuria.Shell</RootNamespace>
    <AssemblyName>Azuria</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- MSB3277 : le paquet WebView2 embarque aussi sa variante WPF (qu'on n'utilise pas),
         d'où un conflit de version inoffensif sur WindowsBase. On le réduit au silence. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- WinForms n'est que l'hôte natif (fenêtre + DWM + montage WebView2).
         Aucune UI n'est dessinée en WinForms : toute l'interface est en HTML/CSS (dossier web). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- Les fichiers de l'UI (DA en CSS) sont copiés à côté de l'exécutable. -->
    <None Update="web\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
